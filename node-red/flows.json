        "format": "<style>\n  table.sensor-table { width:100%; border-collapse:collapse; font-size:13px; }\n  table.sensor-table th { background:#2c3e50; color:white; padding:6px 8px; text-align:left; }\n  table.sensor-table td { padding:5px 8px; border-bottom:1px solid #ddd; }\n  table.sensor-table tr:nth-child(even) { background:#f8f9fa; }\n</style>\n<table class=\"sensor-table\">\n  <tr><th>#</th><th>Horodatage</th><th>T (°C)</th><th>H (%)</th><th>P (hPa)</th></tr>\n  <tr ng-repeat=\"row in msg.payload\">\n    <td>{{row.id}}</td>\n    <td>{{row.timestamp}}</td>\n    <td>{{row.temperature}}</td>\n    <td>{{row.humidite}}</td>\n    <td>{{row.pression}}</td>\n  </tr>\n</table>",
