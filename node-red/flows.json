        "x": 130,
        "y": 200,
        "wires": [["n_merge"]]
    },
    {
        "id": "n_merge",
        "type": "function",
        "name": "Merge + Timestamp",
        "func": "// Accumulate the 3 topics, then emit one combined message\nvar data = flow.get('pending') || {};\nvar topic = msg.topic;\nvar value = parseFloat(msg.payload);\n\nif (topic === '/temperature') data.temperature = value;\nelse if (topic === '/humidite')  data.humidite = value;\nelse if (topic === '/pression')  data.pression = value;\n\nflow.set('pending', data);\n\n// When all 3 are present, emit and reset\nif (data.temperature !== undefined && data.humidite !== undefined && data.pression !== undefined) {\n    var now = new Date();\n    var ts = now.toISOString().replace('T',' ').substring(0,19);\n    var out = {\n        payload: {\n            timestamp: ts,\n            temperature: data.temperature,\n            humidite: data.humidite,\n            pression: data.pression\n        }\n    };\n    flow.set('pending', {});\n    return out;\n}\nreturn null;",
        "outputs": 1,
        "x": 370,
        "y": 140,
        "wires": [["n_insert", "n_chart_t", "n_chart_h", "n_chart_p", "n_gauge_t", "n_gauge_h", "n_gauge_p", "n_debug"]]
    },
    {
        "id": "n_debug",
        "type": "debug",
        "name": "Debug capteurs",
        "active": true,
        "tosidebar": true,
        "x": 590,
        "y": 300
    },
    {
        "id": "n_create_table",
        "type": "inject",
        "name": "Créer table (au démarrage)",
        "props": [{"p": "topic", "vt": "str"}],
        "topic": "CREATE TABLE IF NOT EXISTS measurements (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT NOT NULL DEFAULT (datetime('now','localtime')), temperature REAL, humidite REAL, pression REAL);",
        "once": true,
        "onceDelay": "1",
        "x": 170,
        "y": 340,
        "wires": [["n_sqlite_create"]]
    },
    {
        "id": "n_sqlite_create",
        "type": "sqlite",
        "name": "SQLite: create table",
        "mydb": "sqlite_db_1",
        "sqlquery": "msg.topic",
        "sql": "",
        "x": 430,
        "y": 340,
        "wires": [[]]
    },
    {
        "id": "n_insert",
        "type": "function",
        "name": "Préparer INSERT",
        "func": "var d = msg.payload;\nmsg.topic = \"INSERT INTO measurements (timestamp, temperature, humidite, pression) VALUES ($ts, $temp, $hum, $pres)\";\nmsg.payload = [d.timestamp, d.temperature, d.humidite, d.pression];\nreturn msg;",
        "outputs": 1,
        "x": 590,
        "y": 80,
        "wires": [["n_sqlite_insert"]]
    },
